# Copy to .env and fill in. Never commit .env.

# Hugging Face (Qwen3 models are public; a token avoids rate limits)
HF_TOKEN=
HF_HOME=./hf_cache

# Models
MODEL_ID=Qwen/Qwen3-8B
AWQ_MODEL_ID=Qwen/Qwen3-8B-AWQ
DRAFT_MODEL_ID=Qwen/Qwen3-0.6B

# Server
SERVER_HOST=127.0.0.1
SERVER_PORT=8000

# Cloud: Modal. Authenticate once with `modal setup` (token lives in ~/.modal.toml, not here).
# Only HF_TOKEN above is forwarded into the Modal container.
