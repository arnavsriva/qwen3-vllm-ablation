# Copy to .env and fill in. Never commit .env.

# Hugging Face (Qwen3 models are public; a token avoids rate limits)
HF_TOKEN=
HF_HOME=./hf_cache

# Models
MODEL_ID=Qwen/Qwen3-8B
AWQ_MODEL_ID=Qwen/Qwen3-8B-AWQ
DRAFT_MODEL_ID=Qwen/Qwen3-0.6B

# Server
SERVER_HOST=127.0.0.1
SERVER_PORT=8000

# Cloud (fill in only the one you use)
GCP_PROJECT=
GCP_ZONE=us-central1-a
GCP_INSTANCE_NAME=qwen3-l4-bench
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
